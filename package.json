{
  "name": "stirling-welcome-ar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Stirling Welcome AR: browser AR wayfinding for the University of Stirling campus.",
  "scripts": {
    "postinstall": "node scripts/copy-xr-engine.mjs",
    "dev": "vite",
    "dev:phone": "node scripts/phone-tunnel.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@8thwall/engine-binary": "^1.0.0",
    "@mapbox/vector-tile": "^3.0.0",
    "pbf": "^5.1.2",
    "qrcode-generator": "^1.4.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "qrcode-terminal": "^0.12.0",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
