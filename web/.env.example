# Copy to .env.local and fill in. Never commit real keys.

# Which data source the app uses: "local" (sample data, default) or "mazemap".
MAP_PROVIDER=local

# MazeMap campus id (a number). Must come from the University; do not guess.
MAZEMAP_CAMPUS_ID=TODO

# Optional MazeMap tokens, only if the University's campus needs them (private map / view token).
# They are sent to the browser, as MazeMap's JS API requires.
MAZEMAP_VIEW_TOKEN=
MAZEMAP_AUTH_TOKEN=

# Optional: MapLibre style URLs for the base map. Empty uses OpenFreeMap (positron / dark).
NEXT_PUBLIC_BASEMAP_STYLE_URL=
NEXT_PUBLIC_BASEMAP_STYLE_URL_DARK=
