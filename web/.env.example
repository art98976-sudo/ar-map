# Copy to .env.local and fill in. Never commit real keys.

# Which data source the app uses: "local" (sample data, default) or "mazemap".
MAP_PROVIDER=local

# MazeMap campus id. Must come from the University; do not guess.
MAZEMAP_CAMPUS_ID=TODO

# Optional: a MapLibre style URL for the base map. Leave empty for the built-in OpenStreetMap raster style.
NEXT_PUBLIC_BASEMAP_STYLE_URL=
